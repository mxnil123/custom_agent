# Copy this file to .env and replace the sample values before exposing the services.
LITELLM_MASTER_KEY=sk-local-dev-change-me
AGENT_API_KEY=local-dev-change-me

# OpenAI-compatible base URL for a separately running gemini-web2api-go instance.
# In Docker Desktop, host.docker.internal reaches a service running on this host.
GEMINI_WEB2API_BASE_URL=http://host.docker.internal:8080/v1
GEMINI_WEB2API_API_KEY=local-dev-change-me
